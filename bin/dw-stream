#!/usr/bin/env python3
"""Shared sampler for the desktop widgets: one long-running process instead of a
Python start per widget per tick. Prints one JSON line every --interval seconds:
  {"sample": <dw-sample object>, "signals": <dw-signals object>}   ("signals" only with --signals)
Options: --interval SEC (default 5), --iface NAME (repeatable; counters under sample.nets),
--signals, --agent claude|codex, --command key=<shell> (repeatable, as dw-signals),
--count N (stop after N lines; tests). Exits when stdout closes or its parent goes away.
Standard library only."""
import importlib.machinery, importlib.util, json, os, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))


def _load(name, file):
    spec = importlib.util.spec_from_loader(name, importlib.machinery.SourceFileLoader(name, os.path.join(HERE, file)))
    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m


def parse_args(argv):
    opts = {"interval": 5.0, "ifaces": [], "signals": False, "agent": "claude", "commands": [], "count": 0}
    i = 0
    while i < len(argv):
        a = argv[i]; v = argv[i + 1] if i + 1 < len(argv) else None
        if a == "--signals": opts["signals"] = True; i += 1; continue
        if v is None: break
        if a == "--interval":
            try: opts["interval"] = max(1.0, float(v))
            except ValueError: pass
        elif a == "--iface": opts["ifaces"].append(v)
        elif a == "--agent": opts["agent"] = v
        elif a == "--command": opts["commands"].append(v)
        elif a == "--count":
            try: opts["count"] = max(0, int(v))
            except ValueError: pass
        else: i += 1; continue
        i += 2
    return opts


def main(argv):
    opts = parse_args(argv)
    sample, signals = _load("dw_sample", "dw-sample"), _load("dw_signals", "dw-signals")
    parent, prev, n = os.getppid(), None, 0
    while True:
        start = time.monotonic()
        s = sample.sample(prev_cpu=prev, cpu_pause=0.15, ifaces=opts["ifaces"])
        prev = s.pop("cpu_times", None)
        out = {"sample": s}
        if opts["signals"]: out["signals"] = signals.build(s, opts["agent"], opts["commands"])
        try:
            sys.stdout.write(json.dumps(out) + "\n"); sys.stdout.flush()
        except BrokenPipeError:
            return 0
        n += 1
        if opts["count"] and n >= opts["count"]: return 0
        if os.getppid() != parent: return 0
        time.sleep(max(0.2, opts["interval"] - (time.monotonic() - start)))


if __name__ == "__main__":
    try: sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt: sys.exit(0)
