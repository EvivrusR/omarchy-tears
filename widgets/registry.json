{
  "version": 1,
  "common": [
    {
      "key": "type",
      "type": "type",
      "label": "Type",
      "required": true
    },
    {
      "key": "enabled",
      "type": "boolean",
      "label": "Enabled",
      "default": true
    },
    {
      "key": "corner",
      "type": "enum",
      "label": "Corner",
      "options": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right",
        "top-center",
        "bottom-center"
      ],
      "default": "top-right",
      "description": "*-center ignores x and centres the widget on that edge"
    },
    {
      "key": "x",
      "type": "integer",
      "label": "X offset (px)",
      "default": 48,
      "min": 0,
      "max": 8000
    },
    {
      "key": "y",
      "type": "integer",
      "label": "Y offset (px)",
      "default": 48,
      "min": 0,
      "max": 8000
    },
    {
      "key": "z",
      "type": "integer",
      "label": "Stacking (z)",
      "default": 0,
      "min": -100,
      "max": 100,
      "description": "Lower sits further back; equal z keeps list order"
    },
    {
      "key": "scale",
      "type": "number",
      "label": "Scale",
      "default": 1,
      "min": 0.25,
      "max": 4
    },
    {
      "key": "backdrop",
      "type": "number",
      "label": "Backdrop alpha",
      "default": 0,
      "min": 0,
      "max": 1,
      "description": "Rounded themed card behind the widget; 0 hides it"
    },
    {
      "key": "color",
      "type": "color",
      "label": "Text colour",
      "default": "foreground",
      "description": "Theme token (foreground, background, accent, muted, urgent) or any colour"
    },
    {
      "key": "mutedColor",
      "type": "color",
      "label": "Muted colour",
      "default": "muted"
    },
    {
      "key": "outline",
      "type": "color",
      "label": "Outline colour",
      "default": "#000000",
      "description": "Empty disables outline and halo"
    },
    {
      "key": "halo",
      "type": "number",
      "label": "Halo strength",
      "default": 0.7,
      "min": 0,
      "max": 1
    },
    {
      "key": "align",
      "type": "enum",
      "label": "Text alignment",
      "options": [
        "auto",
        "left",
        "right"
      ],
      "default": "auto"
    },
    {
      "key": "screen",
      "type": "string",
      "label": "Screen",
      "default": "",
      "description": "Output name from hyprctl monitors; empty means every screen"
    }
  ],
  "types": {
    "clock": {
      "displayName": "Clock",
      "description": "Time with the date beneath.",
      "fields": [
        {
          "key": "timeFormat",
          "type": "string",
          "label": "Time format",
          "default": "HH:mm",
          "description": "Qt date/time format"
        },
        {
          "key": "dateFormat",
          "type": "string",
          "label": "Date format",
          "default": "dddd d MMMM",
          "description": "Empty hides the date"
        }
      ]
    },
    "stats": {
      "displayName": "System stats",
      "description": "CPU, memory, disk and battery as bars.",
      "fields": [
        {
          "key": "orientation",
          "type": "enum",
          "label": "Layout",
          "options": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal",
          "description": "vertical stacks each bar under its label, for a narrow column"
        },
        {
          "key": "show",
          "type": "multi-enum",
          "label": "Rows",
          "options": [
            "cpu",
            "mem",
            "disk",
            "battery"
          ],
          "default": [
            "cpu",
            "mem",
            "disk",
            "battery"
          ]
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Refresh (s)",
          "default": 3,
          "min": 1,
          "max": 3600
        },
        {
          "key": "diskPath",
          "type": "path",
          "label": "Disk to watch",
          "default": "/"
        }
      ]
    },
    "command": {
      "displayName": "Command output",
      "description": "Runs a shell command on an interval and shows its output.",
      "fields": [
        {
          "key": "command",
          "type": "command",
          "label": "Command",
          "default": "",
          "description": "Run with bash -lc"
        },
        {
          "key": "title",
          "type": "string",
          "label": "Title",
          "default": ""
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Refresh (s)",
          "default": 60,
          "min": 1,
          "max": 86400
        },
        {
          "key": "timeoutSec",
          "type": "integer",
          "label": "Timeout (s)",
          "default": 10,
          "min": 1,
          "max": 600
        },
        {
          "key": "maxLines",
          "type": "integer",
          "label": "Max lines",
          "default": 8,
          "min": 1,
          "max": 200
        },
        {
          "key": "maxWidth",
          "type": "integer",
          "label": "Max width (px)",
          "default": 420,
          "min": 40,
          "max": 4000
        }
      ]
    },
    "agents": {
      "displayName": "Agent session",
      "description": "Current AI-agent session: percent used and when it ends.",
      "fields": [
        {
          "key": "agent",
          "type": "enum",
          "label": "Agent",
          "options": [
            "claude",
            "codex"
          ],
          "default": "claude"
        },
        {
          "key": "title",
          "type": "string",
          "label": "Title override",
          "default": ""
        },
        {
          "key": "showWeekly",
          "type": "boolean",
          "label": "Show weekly window",
          "default": false
        },
        {
          "key": "timeFormat",
          "type": "string",
          "label": "Clock format",
          "default": "HH:mm"
        },
        {
          "key": "refreshIntervalSec",
          "type": "integer",
          "label": "Self refresh (s)",
          "default": 0,
          "min": 0,
          "max": 86400,
          "description": "0 relies on the bar's Agents widget refresh"
        }
      ]
    },
    "template": {
      "displayName": "Template",
      "description": "Rows rendered from a command's JSON output with {placeholders}.",
      "fields": [
        {
          "key": "command",
          "type": "command",
          "label": "Command",
          "default": "",
          "description": "Should print a JSON object; plain text is available as {output} and {lines.N}"
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Refresh (s)",
          "default": 60,
          "min": 1,
          "max": 86400
        },
        {
          "key": "timeoutSec",
          "type": "integer",
          "label": "Timeout (s)",
          "default": 10,
          "min": 1,
          "max": 600
        },
        {
          "key": "maxWidth",
          "type": "integer",
          "label": "Max width (px)",
          "default": 420,
          "min": 40,
          "max": 4000
        },
        {
          "key": "rows",
          "type": "rows",
          "label": "Rows",
          "default": [],
          "options": [
            "heading",
            "text",
            "kv",
            "bar",
            "spacer"
          ],
          "description": "Each row: kind + its keys; text/label/value take {placeholders}"
        }
      ]
    },
    "shape": {
      "displayName": "Shape",
      "description": "Pure form: a translucent panel, divider, pill or circle to lay behind other widgets.",
      "omitCommon": [
        "color",
        "mutedColor",
        "outline",
        "halo",
        "align",
        "backdrop"
      ],
      "fields": [
        {
          "key": "kind",
          "type": "enum",
          "label": "Kind",
          "options": [
            "rect",
            "pill",
            "circle",
            "line"
          ],
          "default": "rect"
        },
        {
          "key": "width",
          "type": "integer",
          "label": "Width (px)",
          "default": 320,
          "min": 1,
          "max": 8000,
          "description": "Circle: diameter; line: length. Multiplied by scale"
        },
        {
          "key": "height",
          "type": "integer",
          "label": "Height (px)",
          "default": 200,
          "min": 1,
          "max": 8000,
          "description": "Line: thickness; ignored by circle"
        },
        {
          "key": "fill",
          "type": "color",
          "label": "Fill",
          "default": "background",
          "description": "Theme token or any colour"
        },
        {
          "key": "alpha",
          "type": "number",
          "label": "Fill alpha",
          "default": 0.4,
          "min": 0,
          "max": 1
        },
        {
          "key": "border",
          "type": "color",
          "label": "Border colour",
          "default": "accent"
        },
        {
          "key": "borderWidth",
          "type": "integer",
          "label": "Border width (px)",
          "default": 0,
          "min": 0,
          "max": 64,
          "description": "0 = no border"
        },
        {
          "key": "borderAlpha",
          "type": "number",
          "label": "Border alpha",
          "default": 1,
          "min": 0,
          "max": 1
        },
        {
          "key": "radius",
          "type": "integer",
          "label": "Corner radius (px)",
          "default": 12,
          "min": 0,
          "max": 500,
          "description": "rect and line; pill and circle are always round"
        },
        {
          "key": "shadow",
          "type": "number",
          "label": "Shadow",
          "default": 0,
          "min": 0,
          "max": 1,
          "description": "Soft dark shadow strength; 0 = none"
        }
      ]
    },
    "battery": {
      "displayName": "Battery",
      "description": "Charge glyph, percent and time to empty or full; hidden when there is no battery.",
      "fields": [
        {
          "key": "style",
          "type": "enum",
          "label": "Glyph",
          "options": [
            "outline",
            "pixel",
            "text"
          ],
          "default": "outline",
          "description": "outline = icon-font battery, pixel = [████░] segments, text = percent only"
        },
        {
          "key": "showPercent",
          "type": "boolean",
          "label": "Show percent",
          "default": true
        },
        {
          "key": "showTime",
          "type": "boolean",
          "label": "Show time left",
          "default": true,
          "description": "time to empty (discharging) or to full (charging)"
        },
        {
          "key": "warnAt",
          "type": "integer",
          "label": "Warn below (%)",
          "default": 20,
          "min": 0,
          "max": 100
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Refresh (s)",
          "default": 30,
          "min": 5,
          "max": 3600
        }
      ]
    },
    "sysinfo": {
      "displayName": "System info",
      "description": "fastfetch-style block: logo or your own ASCII art beside a key/value table.",
      "fields": [
        {
          "key": "logo",
          "type": "enum",
          "label": "Art",
          "options": [
            "omarchy",
            "arch",
            "arch_small",
            "linux",
            "debian",
            "ubuntu",
            "fedora",
            "nixos",
            "gentoo",
            "void",
            "endeavouros",
            "manjaro",
            "opensuse",
            "alpine",
            "cachyos",
            "garuda",
            "mint",
            "popos",
            "hyprland",
            "none",
            "custom"
          ],
          "default": "omarchy",
          "description": "a common fastfetch logo, none, or custom (type any logo name or paste your own art)"
        },
        {
          "key": "logoName",
          "type": "string",
          "label": "Logo name",
          "default": "",
          "description": "any name from `fastfetch --list-logos`",
          "showWhen": {
            "logo": "custom"
          }
        },
        {
          "key": "art",
          "type": "text",
          "label": "Custom art",
          "default": "",
          "description": "paste ASCII art here (replaces the logo name); monospace, lines kept as typed",
          "showWhen": {
            "logo": "custom"
          }
        },
        {
          "key": "artFile",
          "type": "path",
          "label": "Art file",
          "default": "",
          "description": "or read the art from this text file",
          "showWhen": {
            "logo": "custom"
          }
        },
        {
          "key": "logoPosition",
          "type": "enum",
          "label": "Art position",
          "options": [
            "left",
            "above"
          ],
          "default": "left"
        },
        {
          "key": "logoColor",
          "type": "color",
          "label": "Art colour",
          "default": "accent"
        },
        {
          "key": "fields",
          "type": "multi-enum",
          "label": "Rows",
          "options": [
            "os",
            "host",
            "kernel",
            "uptime",
            "packages",
            "shell",
            "wm",
            "cpu",
            "gpu",
            "memory",
            "disk",
            "ip",
            "battery"
          ],
          "default": [
            "os",
            "kernel",
            "uptime",
            "packages",
            "shell",
            "wm",
            "cpu",
            "memory",
            "disk"
          ]
        },
        {
          "key": "title",
          "type": "boolean",
          "label": "user@host title",
          "default": true
        },
        {
          "key": "swatches",
          "type": "boolean",
          "label": "Colour swatch row",
          "default": true
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Refresh (s)",
          "default": 60,
          "min": 10,
          "max": 86400
        }
      ]
    },
    "monitor": {
      "displayName": "Monitor",
      "description": "CPU, memory, GPU, temperature, load and network over time, as sparklines.",
      "fields": [
        {
          "key": "rows",
          "type": "multi-enum",
          "label": "Rows",
          "options": [
            "cpu",
            "mem",
            "gpu",
            "temp",
            "load",
            "net-down",
            "net-up"
          ],
          "default": [
            "cpu",
            "mem",
            "net-down",
            "net-up"
          ]
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Poll every (s)",
          "default": 10,
          "min": 2,
          "max": 600
        },
        {
          "key": "windowSec",
          "type": "integer",
          "label": "Show last (s)",
          "default": 300,
          "min": 30,
          "max": 3600
        },
        {
          "key": "graph",
          "type": "enum",
          "label": "Graph",
          "options": [
            "sparkline",
            "bars",
            "none"
          ],
          "default": "sparkline"
        },
        {
          "key": "graphHeight",
          "type": "integer",
          "label": "Graph height (px)",
          "default": 28,
          "min": 8,
          "max": 200
        },
        {
          "key": "graphWidth",
          "type": "integer",
          "label": "Graph width (px)",
          "default": 200,
          "min": 40,
          "max": 1200
        },
        {
          "key": "iface",
          "type": "string",
          "label": "Network interface",
          "default": "",
          "description": "empty = the default route's interface"
        },
        {
          "key": "title",
          "type": "string",
          "label": "Title",
          "default": ""
        },
        {
          "key": "downColor",
          "type": "color",
          "label": "Download colour",
          "default": "accent"
        },
        {
          "key": "upColor",
          "type": "color",
          "label": "Upload colour",
          "default": "urgent"
        }
      ]
    },
    "weather": {
      "displayName": "Weather",
      "description": "Current conditions and the next hours for a place you type (Open-Meteo, no location detection), with an optional animated ASCII weather effect across the wallpaper.",
      "omitCommon": [
        "z"
      ],
      "fields": [
        {
          "key": "place",
          "type": "string",
          "label": "Place",
          "default": "Tokyo, Japan",
          "description": "\"City, Country\" — resolved once through Open-Meteo's geocoder and cached"
        },
        {
          "key": "units",
          "type": "enum",
          "label": "Units",
          "options": [
            "metric",
            "imperial"
          ],
          "default": "metric"
        },
        {
          "key": "refreshMin",
          "type": "integer",
          "label": "Refresh (min)",
          "default": 15,
          "min": 5,
          "max": 180
        },
        {
          "key": "layout",
          "type": "enum",
          "label": "Layout",
          "options": [
            "stacked",
            "inline"
          ],
          "default": "stacked"
        },
        {
          "key": "show",
          "type": "multi-enum",
          "label": "Show",
          "options": [
            "place",
            "feels",
            "humidity",
            "wind",
            "hours",
            "attribution"
          ],
          "default": [
            "place",
            "feels",
            "humidity",
            "wind",
            "hours",
            "attribution"
          ]
        },
        {
          "key": "hours",
          "type": "integer",
          "label": "Hours ahead",
          "default": 6,
          "min": 0,
          "max": 12
        },
        {
          "key": "effect",
          "type": "boolean",
          "label": "Weather effect",
          "default": false,
          "description": "animated ASCII rain / snow / clouds / fog / stars across the whole screen"
        },
        {
          "key": "effectPlacement",
          "type": "enum",
          "label": "Effect placement",
          "options": [
            "back",
            "front",
            "custom"
          ],
          "default": "back",
          "description": "back = behind every widget, front = above them all, custom = use z below"
        },
        {
          "key": "z",
          "type": "integer",
          "label": "Effect stacking (z)",
          "default": 0,
          "min": -100,
          "max": 100,
          "showWhen": {
            "effectPlacement": "custom"
          }
        },
        {
          "key": "effectOpacity",
          "type": "number",
          "label": "Effect opacity",
          "default": 0.4,
          "min": 0,
          "max": 1,
          "description": "multiplied by each effect's own preset opacity"
        },
        {
          "key": "effectDensity",
          "type": "number",
          "label": "Effect density",
          "default": 1,
          "min": 0.2,
          "max": 3
        },
        {
          "key": "effectFps",
          "type": "integer",
          "label": "Effect frame rate",
          "default": 6,
          "min": 2,
          "max": 12
        },
        {
          "key": "effectColor",
          "type": "color",
          "label": "Effect colour",
          "default": "foreground"
        }
      ]
    },
    "dock": {
      "displayName": "Launcher dock",
      "description": "A row of app icons that launch on click; lives on the wallpaper like every other widget (clickable where no window covers it).",
      "input": true,
      "defaults": {
        "corner": "bottom-center",
        "y": 8,
        "backdrop": 0.5
      },
      "omitCommon": [
        "align"
      ],
      "fields": [
        {
          "key": "apps",
          "type": "apps",
          "label": "Apps",
          "default": [],
          "description": "desktop-entry ids, in order (see `desktop-widgets apps`)"
        },
        {
          "key": "iconStyle",
          "type": "enum",
          "label": "Icon style",
          "options": [
            "themed",
            "mono",
            "original"
          ],
          "default": "themed",
          "description": "bar-wide: themed = tinted in the widget's text colour, mono = decolourised greys, original = the real icons"
        },
        {
          "key": "iconSize",
          "type": "integer",
          "label": "Icon size (px)",
          "default": 32,
          "min": 16,
          "max": 128
        },
        {
          "key": "spacing",
          "type": "integer",
          "label": "Spacing (px)",
          "default": 8,
          "min": 0,
          "max": 64
        },
        {
          "key": "labels",
          "type": "boolean",
          "label": "Show names",
          "default": false
        },
        {
          "key": "hoverScale",
          "type": "number",
          "label": "Hover zoom",
          "default": 1.2,
          "min": 1,
          "max": 2
        }
      ]
    },
    "pet": {
      "displayName": "Pet",
      "description": "An animated sprite that reacts to something you choose: your Claude session, the battery, running agents, CPU, memory or GPU. Uses the Hermes / petdex sprite-sheet contract, so any petdex pet or a pet hatched in Hermes drops straight in.",
      "omitCommon": [
        "align",
        "outline",
        "halo"
      ],
      "defaults": {
        "corner": "bottom-right",
        "y": 8,
        "x": 48
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "label": "Name",
          "default": "",
          "description": "how other pets refer to this one in rules (pets.<name>.state); default: the sheet's folder name"
        },
        {
          "key": "petdex",
          "type": "petdex",
          "label": "Get a pet",
          "description": "paste a petdex.dev pet URL and press Download; the sheet lands in ~/.config/omarchy/desktop-widgets.pets/<slug>/ and this pet points at it"
        },
        {
          "key": "sheet",
          "type": "path",
          "label": "Sprite sheet",
          "default": "",
          "description": "Path to a spritesheet.webp (192×208 cells, 8×9). Find pets: https://petdex.dev (thousands, download → ~/.config/omarchy/desktop-widgets.pets/<name>/), or hatch one in Hermes with /hatch (lands in ~/.hermes/pets/<slug>/). `desktop-widgets pets` lists every sheet on this machine; the plugin ships examples/pets/hermes-girl."
        },
        {
          "key": "watch",
          "type": "enum",
          "label": "Watches",
          "options": [
            "claude",
            "battery",
            "agents",
            "cpu",
            "mem",
            "gpu",
            "custom"
          ],
          "default": "claude",
          "description": "what this pet reacts to; custom uses the rules below"
        },
        {
          "key": "rules",
          "type": "rows",
          "label": "Rules (custom)",
          "options": [
            "range",
            "flag",
            "keyword",
            "pet",
            "when",
            "on"
          ],
          "default": [],
          "showWhen": {
            "watch": "custom"
          },
          "rowFields": {
            "signal": { "enum": "signals" },
            "look": { "enum": "looks" },
            "then": { "enum": "looks" },
            "state": { "enum": "looks" },
            "pet": { "enum": "pets" },
            "is": { "type": "boolean" },
            "match": { "options": ["any", "all", "none"] },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "beat": { "type": "number" }
          },
          "description": "top-down, first steady match wins; a row with `beat` plays once for that many seconds when it turns true. range = brackets on a number (min ≤ value < max; min > max wraps for hour); flag = true/false; keyword = comma-separated words in a text signal (match any/all/none); pet = when another pet shows a look; when/on = a raw test (signals: claude.session, claude.weekly, claude.resetInMin, claude.label, battery.pct/status/charging/discharging/full, agents.active, cpu, mem, gpu, load, temp, hour, custom.<key>, pets.<name>.state/say). `and` adds a raw extra condition to any row."
        },
        {
          "key": "signals",
          "type": "rows",
          "label": "Extra signals",
          "options": [
            "command"
          ],
          "default": [],
          "description": "commands sampled with the pet's signals; each becomes custom.<key> (numbers parsed, text kept). e.g. key window, command `hyprctl activewindow -j | jq -r .title`"
        },
        {
          "key": "size",
          "type": "integer",
          "label": "Size (px)",
          "default": 96,
          "min": 24,
          "max": 512,
          "description": "sprite height; the sheet's 192×208 cell is scaled to this"
        },
        {
          "key": "fps",
          "type": "integer",
          "label": "Frame rate",
          "default": 6,
          "min": 2,
          "max": 12
        },
        {
          "key": "bubble",
          "type": "boolean",
          "label": "Speech bubble",
          "default": true,
          "description": "shows the matched rule's text above the pet"
        },
        {
          "key": "flip",
          "type": "boolean",
          "label": "Face left",
          "default": false
        },
        {
          "key": "intervalSec",
          "type": "integer",
          "label": "Check every (s)",
          "default": 5,
          "min": 2,
          "max": 120
        },
        {
          "key": "layers",
          "type": "rows",
          "label": "Layers (props / outfits)",
          "options": [
            "image",
            "sheet"
          ],
          "default": [],
          "description": "drawn with the body: image = a static PNG/SVG prop (path, z back|front, x/y offset in cell px, scale); sheet = another sprite sheet in the same atlas that follows the body's row and frame (follow = row to use when it lacks one). `desktop-widgets pets` lists props under ~/.config/omarchy/desktop-widgets.pets/props/"
        }
      ]
    }
  }
}
